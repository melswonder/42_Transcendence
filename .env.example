# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=transcendence

# Backend
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/transcendence
# ローカルのPostgresはTLS無効。Atlas(lib/pq)は既定がrequireなので明示が必要。
# 本番では verify-full にする。
PGSSLMODE=disable

# Frontend
# クライアントサイド（ブラウザ）からバックエンドAPIへのアクセス用
# 注意: ブラウザから実行されるため localhost を使用します
NEXT_PUBLIC_API_URL=https://localhost:8443

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# HTTPS の入口 (Caddy)
# ホストの 443 を bind できない環境（rootless Docker 等）では、
# 下の 2 行を有効にして https://localhost:4443 でアクセスする。
#FRONTEND_HTTPS_PORT=4443
#FRONTEND_URL=https://localhost:4443
