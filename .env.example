# google Oauth2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- ブラウザから見た API の入口 -------------------------------------------
# Caddy がフロントと同一オリジンの /api を backend へ流す。
# 別オリジン(:8443)を指すとセッション Cookie がブラウザに保存されないことがある。
NEXT_PUBLIC_API_URL=https://localhost/api

# --- 別 PC からもアクセスするとき -----------------------------------------
# 下の 3 つをコメント解除して、同じホストに揃える。
# Wi-Fi は端末間通信を遮断していることが多いので Tailscale の IP 推奨。
# 別 PC 側では https://<HOST> の証明書を一度信頼する。
# GOOGLE_REDIRECT_URL は Google Cloud Console 側にも同じ値の登録が必要。
#PUBLIC_HOST=100.x.x.x
#FRONTEND_URL=https://100.x.x.x
#NEXT_PUBLIC_API_URL=https://100.x.x.x/api

# --- ホストの 443 を bind できないとき（rootless Docker 等）----------------
# 3 つセットで :4443 を付ける。
FRONTEND_HTTPS_PORT=4443
FRONTEND_URL=https://localhost:4443
NEXT_PUBLIC_API_URL=https://localhost:4443/api
