# google oauth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- 別 PC からもアクセスするとき -----------------------------------------
# 下の 4 つをコメント解除して、同じホストに揃える。
# Wi-Fi は端末間通信を遮断していることが多いので Tailscale の IP 推奨。
# 別 PC 側では https://<HOST> と https://<HOST>:8443 の証明書を一度ずつ信頼する。
# GOOGLE_REDIRECT_URL は Google Cloud Console 側にも同じ値の登録が必要。
#PUBLIC_HOST=100.x.x.x
#FRONTEND_URL=https://100.x.x.x
#NEXT_PUBLIC_API_URL=https://100.x.x.x:8443
#GOOGLE_REDIRECT_URL=https://100.x.x.x:8443/auth/google/callback

# --- ホストの 443 を bind できないとき（rootless Docker 等）----------------
# FRONTEND_URL にも :4443 を付ける。
#FRONTEND_HTTPS_PORT=4443
# FRONTEND_URL=https://localhost:4443
