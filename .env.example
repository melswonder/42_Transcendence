# ルートの .env（docker compose が読む）。
# コピーして使う: cp .env.example .env
# 注意: 同じ変数を 2 回書かない。切り替えるときは値そのものを書き換える。

# --- Database -----------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=transcendence

# ホストから atlas / make が使う接続先（コンテナ内は compose が別途指定する）。
# ローカルの Postgres は TLS 無効。Atlas(lib/pq) は既定が require なので明示する。
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/transcendence
PGSSLMODE=disable

# --- Google OAuth（必須。未設定だと backend が起動しない） ---------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- URL（アクセス方法で 3 つセットで切り替える） ------------------------
# ブラウザから見た API / フロントの URL。CORS と WebSocket の許可、
# ログイン後の戻り先はすべて FRONTEND_URL に追従する。
#
# 1) 普段（この PC だけで使う）: このままで OK
NEXT_PUBLIC_API_URL=https://localhost:8443
FRONTEND_URL=https://localhost
#
# 2) 別 PC からも見る: 3 つとも同じホストに書き換える
#    （Wi-Fi は端末間通信を遮断していることが多いので、Tailscale の IP 推奨。
#      別 PC 側では https://<HOST> と https://<HOST>:8443 の両方の証明書を一度信頼する）
#PUBLIC_HOST=100.x.x.x
#NEXT_PUBLIC_API_URL=https://100.x.x.x:8443
#FRONTEND_URL=https://100.x.x.x

# --- その他のオプション ---------------------------------------------------
# ホストの 443 を bind できない環境（rootless Docker 等）では別ポートにして、
# FRONTEND_URL にも :4443 を付ける。
#FRONTEND_HTTPS_PORT=4443
