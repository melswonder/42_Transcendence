# frontend をホストで直接動かすとき用（docker のときはルートの .env を使う）。
# コピーして使う: cd frontend && cp .env.example .env.local

# ブラウザから見た API の URL。NEXT_PUBLIC_ 付きはブラウザに埋め込まれるので
# 秘密情報は絶対に入れない。
NEXT_PUBLIC_API_URL=https://localhost:8443

# Server Component からの API 呼び出し先（ホスト実行ならどちらも localhost 系）
API_URL=http://localhost:4000
