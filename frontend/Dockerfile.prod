# 本番・評価用のフロントエンド。next build の成果物を standalone で動かす。
# dev サーバーは Fast Refresh などをブラウザのコンソールに出すので、コンソールを
# 検査する用途ではこちらを使う。dev 構成は docker-compose.dev.yml。

FROM node:22-alpine AS build
WORKDIR /app
RUN corepack enable pnpm
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN corepack install && pnpm install --frozen-lockfile
COPY . .
# NEXT_PUBLIC_* はバンドルへ焼き込まれるので、runtime の env では効かない。
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL NEXT_STANDALONE=1
RUN pnpm build

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
# standalone に入るのは server.js と実行に必要な node_modules だけ。
# static と public は別途コピーする必要がある。
COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static
COPY --from=build /app/public ./public
# Docker は HOSTNAME にコンテナ ID を入れる。server.js はそれを bind アドレスに
# 使うので、caddy から届くよう 0.0.0.0 に上書きする。
ENV HOSTNAME=0.0.0.0 PORT=3000
EXPOSE 3000
CMD ["node", "server.js"]
