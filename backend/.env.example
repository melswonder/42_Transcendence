DATABASE_URL=postgresql://postgres:postgres@localhost:5432/transcendence
# ローカルのPostgresはTLS無効。Atlas(lib/pq)は既定がrequireなので明示が必要。
# 本番では verify-full にする。
PGSSLMODE=disable
PORT=4000

# oauth2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:4000/auth/google/callback
FRONTEND_URL=http://localhost:3000