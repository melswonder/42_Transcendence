# backend をホストで直接動かすとき用（docker のときはルートの .env を使う）。
# コピーして使う: cd backend && cp .env.example .env

PORT=4000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/transcendence
# ローカルの Postgres は TLS 無効。Atlas(lib/pq) は既定が require なので明示する。
# マネージド DB に繋ぐときは require / verify-full にする。
PGSSLMODE=disable

# Google OAuth（必須。Google Cloud Console に登録した値と完全一致させる）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=https://localhost:8443/auth/google/callback

# ログイン後にブラウザを戻す先。CORS / WebSocket の許可もこの値に追従する。
FRONTEND_URL=https://localhost

# アップロードされたアバターの保存先
MEDIA_DIR=./uploads

# Public API のレート制限（リクエスト/分/キー）
PUBLIC_API_RATE_LIMIT=60
